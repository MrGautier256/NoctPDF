{
  "name": "noctpdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dark mode for PDFs in Chromium browsers, with a customizable PDF.js reader.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "test:browsers": "node test/browsers/smoke.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "icons": "node scripts/make-icons.ts",
    "pdfjs:update": "node scripts/update-pdfjs.ts"
  },
  "dependencies": {
    "valibot": "^1.5.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
